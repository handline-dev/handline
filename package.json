{
  "name": "handline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"{packages,apps,web}/**/*.{ts,tsx,js,mjs,json,css}\" \"*.json\"",
    "format:check": "prettier --check \"{packages,apps,web}/**/*.{ts,tsx,js,mjs,json,css}\" \"*.json\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@types/node": "^22",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2",
    "typescript": "^5.9",
    "typescript-eslint": "^8.71.1"
  }
}

{
  "expo": {
    "name": "Handline",
    "slug": "handline",
    "scheme": "handline",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.handline.mobile"
    },
    "plugins": [
      "./plugins/tailscale-cleartext.cjs",
      "./plugins/ios-rn-from-source.cjs",
      "./plugins/android-release.cjs",
      [
        "expo-camera",
        {
          "cameraPermission": "Handline scans the pairing code shown on your computer.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "dev.handline.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}

{
  "name": "@handline/electron",
  "private": true,
  "type": "module",
  "description": "The desktop shell: one window on the built apps/web, one instance, a dock badge from the inbox count, native notifications",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.ts",
    "start": "node build.ts && electron .",
    "test": "node --test --test-timeout=10000 --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": { "@handline/client": "workspace:*", "@handline/client-node": "workspace:*" },
  "devDependencies": { "@handline/config": "workspace:*", "@handline/fake-daemon": "workspace:*", "@handline/web": "workspace:*", "electron": "^38", "esbuild": "^0.25" }
}

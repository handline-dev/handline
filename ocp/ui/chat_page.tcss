/* The new agent chat page's layout. Edit, then rerun
   `python3 -m ocp.ui.chat_page`. */

ChatPage { overflow: hidden; }

/* Nested under .chat_page (ChatPage and TaskDetail carry it) so these ids and
   classes cannot restyle another screen when the bridge loads this file. */
.chat_page {
    #body { height: 1fr; overflow: hidden; }
    #transcript { width: 1fr; scrollbar-size-vertical: 0; padding: 0 0 1 1; align-vertical: bottom; background: $surface-lighten-1; }
    #dock { dock: bottom; height: auto; padding-bottom: 1; background: $surface-lighten-1; }
    #composer { height: auto; padding: 1 2; background: $panel; border-left: thick $primary; }
    #compose, #compose:focus { height: auto; min-height: 1; max-height: 8; border: none; padding: 0; background: transparent; }
    #status { height: 1; margin-top: 1; color: $text-muted; }

    .msg { height: auto; margin: 1 0 0 0; padding: 0 1 0 0; }
    .msg .who { text-style: bold; }
    .msg.me { background: $foreground 8%; border-left: thick $primary; padding-left: 1; }
    .msg.them { background: $surface-lighten-1; }
    .msg.them .who { color: $success; }
    .msg.other .who { color: $text-muted; }
    .msg.other { color: $text-muted; }

    .msg.replying { border-left: thick $warning; }

    #detail_pane { padding: 1 3; }
    #t_title { text-style: bold; padding-bottom: 1; }
    #t_badge { padding-bottom: 1; }
    #t_meta { padding-bottom: 1; }
    .section { padding-top: 1; border-top: solid $primary-darken-1; margin-top: 1; height: auto; }

    #menu { display: none; height: auto; max-height: 6; margin: 0 0 0 0; padding: 0 2;
            background: $panel; border: none; border-left: thick $primary-darken-1; }
    #menu > .option-list--option-highlighted { background: $primary 30%; }

    .msg.pending { opacity: 60%; }
    .queueline { height: 1; margin: 1 0 0 0; }

    .qrow { height: 1; margin-top: 1; }
    .qstate { width: 1fr; color: $text-muted; }
    .qrow Button { width: auto; min-width: 10; margin-right: 1; }

    #t_top { height: 2; margin: 1 0 0 1; }
    #t_top Button { width: auto; min-width: 0; height: 100%; }

    #settings_view { display: none; height: 1fr; }
    #settings_pane { height: 1fr; padding: 1 3; }
    .frow { height: 1; margin-bottom: 1; }
    .flabel { width: 18; color: $text-muted; }
    .fvalue { width: 1fr; }
    .frow Input, .frow Select { width: 40; }
    .frow #s_context_k { width: 10; }
    .frow .unit { width: 10; padding-left: 1; }
    .frow .note { width: 1fr; padding-left: 1; color: $text-muted; }
    .flash { height: 1; padding: 0 3; color: $text-muted; }
}

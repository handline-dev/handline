#!/usr/bin/env bash
# A bash wrapper, not a python shebang (a founder ruling): a python
# shebang has already committed to an interpreter before any of our own code
# runs, so nothing written in python can be the thing that picks one. bash is
# the one thing macOS guarantees is there when python3 might not be right (a
# Homebrew python3 with no PyYAML or rich, or a system one with neither).
#
# A missing or stale venv used to make this refuse
# outright. It now falls back to PATH's python3 instead, the same interpreter
# this file used to run under unconditionally - so every verb but a tty
# `hl` (which prints the venv fix and exits 1) keeps working until the
# venv is ready, and `hl venv install` itself
# bootstraps under that same PATH python3. Do not turn the fallback back into
# a refusal; handline/infra/venv.py's status() is still the one place that judges
# ready-ness and its reasoning must stay in sync with the check below.
set -euo pipefail

if [ -n "${HANDLINE_HOME:-}" ]; then
    home_dir="$HANDLINE_HOME"
elif [ -n "${OCP_HOME:-}" ]; then
    home_dir="$OCP_HOME"
elif [ -d "$HOME/.handline" ]; then
    home_dir="$HOME/.handline"
else
    home_dir="$HOME/.orcapipe"
fi
venv="$home_dir/venv"
py="$venv/bin/python3"

# handline/cli/ and handline/infra/service.py both describe the installed `hl` as a
# symlink into the repo, not a copy - so BASH_SOURCE (the symlink's own
# path) has to be resolved to where the real bin/hl lives before script_dir
# is derived from it, or _ocp_entry.py and requirements.txt are looked for
# beside the symlink instead of beside this file. No `readlink -f` on macOS,
# so walk the links by hand.
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
    target="$(readlink "$source")"
    case "$target" in
        /*) source="$target" ;;
        *) source="$(dirname "$source")/$target" ;;
    esac
done
script_dir="$(cd "$(dirname "$source")" && pwd)"
reqs="$script_dir/../requirements.txt"
stamp="$venv/.ocp_deps_sha256"

ready=0
if [ -x "$py" ] && [ -f "$reqs" ] && [ -f "$stamp" ]; then
    # handline/infra/venv.py's `_canonical_requirements`, in bash: strip each line, drop
    # blank ones and whole-line comments, hash what is left - a comment-only
    # edit must not read as stale.
    # `|| true`: grep exits 1 if nothing survives the filter (an empty or
    # all-comments requirements.txt) - under pipefail that would abort the
    # script right here, the same silent-exit class an earlier review fixed for
    # the stamp read below.
    want="$( { sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$reqs" \
        | grep -v '^#' | grep -v '^$' || true; } | shasum -a 256 | cut -d' ' -f1)"
    have=""
    # `read` returns 1 on a stamp with no trailing newline (EOF before the
    # newline it looks for) even though it fills $have - under set -e that
    # would exit the script right here, silently falling back to PATH's
    # python3 without a real reason. `|| true` keeps that a plain "not ready"
    # instead (that review's fix, carried over from bin/ocp-venv).
    read -r have < "$stamp" || true
    [ "$want" = "$have" ] && ready=1
fi

[ "$ready" = 1 ] || py=python3

# The Go hl once tools/build-hl.sh has built it: it runs the commands it has ported and hands every other one to this
# same Python. HANDLINE_HL_GO=0 keeps everything on Python. A build of other Go source than this checkout's go/ (a pull
# since, or none recorded) is not run: Python answers, slower and current, and `hl doctor` says to rebuild. Outside a
# git checkout there is nothing to compare, and the build is run. Every git checkout, pull or commit rewrites git's
# index, so a stamp newer than it needs no git call; this runs before every hook, so that is the usual path.
gohl="$script_dir/../go/hl"
if [ -x "$gohl" ] && [ "${HANDLINE_HL_GO:-${OCP_HL_GO:-1}}" != 0 ]; then
    gitdir="$script_dir/../.git"
    if [ -f "$gitdir" ]; then                    # a worktree: .git names where its git directory is
        line=""
        read -r line < "$gitdir" || true
        gitdir="${line#gitdir: }"
        case "$gitdir" in /*) ;; *) gitdir="$script_dir/../$gitdir" ;; esac
    fi
    if [ -f "$gohl.src" ] && [ "$gohl.src" -nt "$gitdir/index" ]; then
        HANDLINE_HL_PYTHON="$py" exec "$gohl" "$@"
    fi
    built=""
    [ -f "$gohl.src" ] && { read -r built < "$gohl.src" || true; }
    source_now="$(git -C "$script_dir/.." rev-parse HEAD:go 2>/dev/null || true)"
    if [ -z "$source_now" ] || [ "$source_now" = "$built" ]; then
        [ -n "$built" ] && touch "$gohl.src" 2>/dev/null || true
        HANDLINE_HL_PYTHON="$py" exec "$gohl" "$@"
    fi
fi
exec "$py" "$script_dir/_ocp_entry.py" "$@"

  {
   "name": "attachment.put.a_wrong_offset_is_bad_request",
   "spec": "attachment.put",
   "about": "A chunk that does not start where the daemon holds is bad_request naming offset; the upload goes on from where it was.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "iVBORw0KGgo=",
       "request_id": "conf-at-6",
       "offset": 0
      }
     },
     "result": {
      "upload": {
       "$type": "string",
       "$save": "up"
      },
      "received": 8
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "Rw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
       "request_id": "conf-at-7",
       "offset": 3,
       "upload": "{{up}}"
      }
     },
     "error": {
      "code": -32602,
      "data": {
       "code": "bad_request",
       "field": "offset"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "AAAADUlIRFIAAAABAAAAAQgGAAAAHxXEiQAAAA1JREFUeNpj/M/AUA8ABIUBgISpjCEAAAAASUVORK5CYII=",
       "request_id": "conf-at-8",
       "offset": 8,
       "upload": "{{up}}"
      }
     },
     "result": {
      "received": 70,
      "attachment": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70
      }
     }
    }
   ]

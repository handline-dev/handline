  {
   "name": "chat.send.a_body_names_images_and_the_list_adds_more",
   "spec": "chat.send",
   "about": "A message's images are those its body names, then the listed ids it does not name, each once: ChatMessage.attachments lists them in that order and request.read cuts the body into parts, with no path for a founder.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
       "request_id": "conf-at-40"
      }
     },
     "result": {
      "attachment": {
       "id": {
        "$regex": "^[0-9a-f]{16}$",
        "$save": "a"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
       "request_id": "conf-at-41"
      }
     },
     "result": {
      "attachment": {
       "id": {
        "$regex": "^[0-9a-f]{16}$",
        "$save": "b"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "see ![the button](attachment:{{a}})",
       "attachments": [
        "{{b}}",
        "{{a}}"
       ],
       "request_id": "conf-at-42"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$save": "rid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "request.read",
      "params": {
       "id": "{{rid}}"
      }
     },
     "result": {
      "body": "see ![the button](attachment:{{a}})",
      "parts": [
       {
        "text": "see "
       },
       {
        "image": {
         "id": "{{a}}",
         "name": "a.png",
         "mime": "image/png",
         "bytes": 70
        },
        "caption": "the button",
        "path": {
         "$absent": true
        }
       },
       {
        "image": {
         "id": "{{b}}",
         "name": "a.png",
         "mime": "image/png",
         "bytes": 70
        },
        "caption": ""
       }
      ]
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "chat.messages",
      "params": {
       "agent": "{{ask_agent}}",
       "scope": "mine"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "id": "{{rid}}",
        "attachments": [
         {
          "id": "{{a}}",
          "name": "a.png",
          "mime": "image/png",
          "bytes": 70
         },
         {
          "id": "{{b}}",
          "name": "a.png",
          "mime": "image/png",
          "bytes": 70
         }
        ]
       }
      }
     }
    }
   ]
  },

 "fixtures": [
  {
   "name": "attachment.put.an_agent_session_is_refused",
   "spec": "attachment.put",
   "about": "A call from an agent session is refused, gate role.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
       "request_id": "conf-at-1"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "role"
      }
     }
    }
   ]
  },

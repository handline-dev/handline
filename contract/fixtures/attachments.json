  {
   "name": "attachment.put.a_png_in_one_chunk_is_read_back",
   "spec": "attachment.put",
   "about": "A whole PNG in one chunk answers with its Attachment, and attachment.get returns the same bytes and, with thumb, a small copy.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
       "request_id": "conf-at-9"
      }
     },
     "result": {
      "received": 70,
      "attachment": {
       "id": {
        "$regex": "^[0-9a-f]{16}$",
        "$save": "aid"
       },
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "attachment.get",
      "params": {
       "id": "{{aid}}"
      }
     },
     "result": {
      "mime": "image/png",
      "bytes": 70,
      "offset": 0,
      "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
      "done": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "attachment.get",
      "params": {
       "id": "{{aid}}",
       "thumb": true
      }
     },
     "result": {
      "mime": {
       "$regex": "^image/(png|jpeg)$"
      },
      "offset": 0,
      "done": true,
      "data": {
       "$type": "string"
      }
     }
    }
   ]
  },

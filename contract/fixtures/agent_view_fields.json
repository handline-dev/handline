   "name": "agent.get.view_fields_ready",
   "spec": "agent.get",
   "about": "An idle agent whose current task is queued and held by no open blocker: ready is true, task_count is at least 1 and it has no wall, in agent.get and in agents.list (kind is always a string). Needs --var view_ready_agent: an idle agent whose current task is queued and held by no open blocker.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.get",
      "params": {
       "agent": "{{view_ready_agent}}"
      }
     },
     "result": {
      "name": "{{view_ready_agent}}",
      "kind": {
       "$type": "string"
      },
      "ready": true,
      "task_count": {
       "$type": "integer"
      },
      "wall": null
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "agents.list",
      "params": {}
     },
     "result": {
      "agents": {
       "$contains": {
        "name": "{{view_ready_agent}}",
        "kind": {
         "$type": "string"
        },
        "ready": true,
        "task_count": {
         "$type": "integer"
        },
        "wall": null
       }
      }

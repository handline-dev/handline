{
 "fixtures": [
  {
   "name": "agents.list.states_are_lower_case_words",
   "spec": "agents.list",
   "about": "Every row's state is a lower-case word (x-state-words): IDLE, RUNNING, PENDING and the daemon's other internal or view words are never sent.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {
      "role": "founder"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agents.list",
      "params": {}
     },
     "result": {
      "agents": {
       "$type": "array",
       "$each": {
        "state": {
         "$regex": "^[a-z][a-z_]*$"
        }
       }
      }
     }
    }
   ]
  },
  {
   "name": "agent.get.state_running",
   "spec": "agent.get",
   "about": "An agent in state `running` is sent as the word `running`, in agent.get and in agents.list. Needs --var state_running: an agent in that state (what it means is in x-state-words).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {
      "role": "founder"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.get",
      "params": {
       "agent": "{{state_running}}"
      }
     },
     "result": {
      "state": "running"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "agents.list",
      "params": {}
     },
     "result": {
      "agents": {
       "$contains": {
        "state": "running"
       }
      }
     }
    }
   ]
  },

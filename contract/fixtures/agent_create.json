  {
   "name": "agent.create.an_agent_session_is_refused_by_role",
   "spec": "agent.create",
   "about": "NOT_YET_IN_PYTHON Creating an agent is the founder's: a call from an agent session is refused, gate role.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.create",
      "params": {
       "name": "conf.new",
       "role": "worker",
       "repo": "/no/such/repo",
       "request_id": "conf-ac-1"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "role"
      }
     }
    }
   ]
  },

  {
   "name": "agent.create.runs_to_done",
   "spec": "agent.create",
   "about": "NOT_YET_IN_PYTHON A good call replies with an operation id; the operations topic sends operation.progress until the operation is done, with the agent, and operation.get then says done. Needs --var create_repo, create_name (a name no agent has).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "operations"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "agent.create",
      "params": {
       "name": "{{create_name}}",
       "role": "worker",
       "repo": "{{create_repo}}",
       "base": "main",
       "request_id": "conf-ac-11"
      }
     },
     "result": {
      "accepted": true,
      "operation": {
       "$save": "op_id"
      }
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "operations",
        "type": "operation.progress",
        "data": {
         "kind": "agent.create",
         "state": "running",
         "agent": {
          "$type": "string"
         }
        }
       }
      },
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "operations",
        "type": "operation.progress",
        "data": {
         "kind": "agent.create",
         "state": "done",
         "agent": {
          "$type": "string"
         },
         "result": {
          "registered": true
         }
        }
       }
      }
     ],
     "notices_within_s": 5
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "operation.get",
      "params": {
       "operation": "{{op_id}}"
      }
     },
     "result": {
      "id": "{{op_id}}",
      "kind": "agent.create",
      "state": "done",
      "agent": "{{create_name}}"
     }
    }
   ]
  },

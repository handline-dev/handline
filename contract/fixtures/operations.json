  {
   "name": "agent.create.is_refused_to_an_agent_session",
   "spec": "agent.create",
   "about": "Below the method's role: refused, gate role, nothing started.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.create",
      "params": {
       "name": "fixture.noop",
       "role": "checks the new agent",
       "repo": "/tmp",
       "request_id": "conf-op-1"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "role"
      }
     }
    }
   ]
  },

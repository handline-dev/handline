  {
   "name": "agent.create.answers_an_operation_that_ends_done_or_failed",
   "spec": "agent.create",
   "about": "The reply names an operation; operation.get reads it, running until its steps end. A start that cannot happen leaves the agent registered and says so.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.create",
      "params": {
       "name": "{{new_agent}}",
       "role": "checks the new agent",
       "repo": "{{repo_dir}}",
       "request_id": "conf-op-5"
      }
     },
     "result": {
      "accepted": true,
      "operation": {
       "$save": "op",
       "$type": "string"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "operation.get",
      "params": {
       "operation": "{{op}}"
      }
     },
     "result": {
      "id": {
       "$type": "string"
      },
      "kind": "agent.create",
      "agent": {
       "$type": "string"
      },
      "steps_total": 2,
      "state": {
       "$oneOf": [
        "running",
        "done",
        "failed"
       ]
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "agent.create",
      "params": {
       "name": "{{new_agent}}",
       "role": "checks the new agent",
       "repo": "{{repo_dir}}",
       "request_id": "conf-op-5"
      }
     },
     "result": {
      "accepted": true,
      "operation": {
       "$type": "string"
      },
      "replayed": true
     }
    }
   ]
  },

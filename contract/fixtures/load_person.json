{
 "fixtures": [
  {
   "name": "x-status.load_never_holds_the_persons_message",
   "spec": "x-status",
   "about": "With the load limit tripped by any load (load_per_core_pct 1), a message the person sends still wakes its agent: within a tick the agent's timeline records load_limit_passed after the send. The limit is put back before the check. Needs --var load_wake_agent: a closed agent that nothing but the load would hold, on an account with room.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.timeline",
      "params": {
       "agent": "{{load_wake_agent}}",
       "limit": 1
      }
     },
     "result": {
      "items": [
       {
        "id": {
         "$save": "before"
        }
       }
      ],
      "more": {
       "$type": "boolean"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "settings.set",
      "params": {
       "changes": {
        "load_per_core_pct": 1
       },
       "request_id": "conf-ld-1"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.send",
      "params": {
       "agent": "{{load_wake_agent}}",
       "body": "load probe from the person",
       "request_id": "conf-ld-2"
      }
     },
     "result": {}
    },
    {
     "sleep_s": 15,
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "settings.set",
      "params": {
       "changes": {
        "load_per_core_pct": null
       },
       "request_id": "conf-ld-3"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "agent.timeline",
      "params": {
       "agent": "{{load_wake_agent}}",
       "limit": 20
      }
     },
     "result": {
      "items": {
       "$contains": {
        "kind": "load_limit_passed",
        "id": {
         "$above": "before"
        }
       }
      }
     }
    }
   ]
  }
 ]
}

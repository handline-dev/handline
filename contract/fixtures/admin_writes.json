  {
   "name": "schedule.add.then_edit_then_remove",
   "spec": "schedule.add",
   "about": "A schedule is added and gets an id; edited, it answers its new id; removed, it is gone and removing it again is not_found.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {

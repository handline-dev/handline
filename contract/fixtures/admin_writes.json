       "request_id": "conf-w2-21"
      }
     },
     "result": {
      "accepted": true,
      "said": {
       "$type": "string"
      },
      "schedule": {
       "$type": "integer",
       "$save": "sid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "schedule.add",
      "params": {
       "target": "{{schedule_agent}}",
       "cron": "0 9 * * *",

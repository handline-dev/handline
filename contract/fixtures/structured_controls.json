  {
   "name": "prompt.answer.a_structured_prompt_takes_allow_or_deny",
   "spec": "prompt.answer",
   "about": "NOT_YET_IN_PYTHON: A structured agent's permission prompt offers allow and deny; esc and yes are bad_request, allow answers it and the transcript shows the answer.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "prompt.list",
      "params": {
       "agent": "{{asking_agent}}"
      }
     },
     "result": {
      "prompts": [
       {
        "id": {
         "$save": "ask_id"
        },
        "options": [
         {
          "key": "allow"
         },
         {
          "key": "deny"
         }
        ]
       }
      ]
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "prompt.answer",
      "params": {
       "agent": "{{asking_agent}}",
       "prompt": "{{ask_id}}",
       "choice": "esc",
       "request_id": "sc-ans-1"
      }
     },
     "error": {
      "code": {
       "$oneOf": [
        -32600,
        -32602
       ]
      },
      "data": {
       "code": "bad_request",
       "field": "choice"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "prompt.answer",
      "params": {
       "agent": "{{asking_agent}}",
       "prompt": "{{ask_id}}",
       "choice": "yes",
       "request_id": "sc-ans-2"
      }
     },
     "error": {
      "code": {
       "$oneOf": [
        -32600,
        -32602
       ]
      },
      "data": {
       "code": "bad_request",
       "field": "choice"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "prompt.answer",
      "params": {
       "agent": "{{asking_agent}}",
       "prompt": "{{ask_id}}",
       "choice": "allow",
       "request_id": "sc-ans-3"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "transcript.events",
      "params": {
       "agent": "{{asking_agent}}"
      }
     },
     "result": {
      "events": {
       "$contains": {
        "kind": "permission_answer",
        "permission_answer": {
         "behavior": "allow"
        }
       }
      }
     }
    }
   ]
  }

   "spec": "agent.get",
   "about": "NOT_YET_IN_PYTHON: A structured agent reads structured true with no terminal and no input holder; its session is open while the session lives.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.get",
      "params": {
       "agent": "{{structured_agent}}"
      }
     },
     "result": {

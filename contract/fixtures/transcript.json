  {
   "name": "transcript.events.no_such_agent",
   "spec": "transcript.events",
   "about": "An agent that is not registered is not_found.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "transcript.events",
      "params": {
       "agent": "no.such.agent"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found"
      }
     }
    }
   ]
  },

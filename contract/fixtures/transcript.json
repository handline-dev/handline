  {
   "name": "transcript.events.seq_goes_up_by_one",
   "spec": "transcript.events",
   "about": "The page is in order: seq goes up by exactly 1 from one event to the next, and more says there are others.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "transcript.events",
      "params": {
       "agent": "{{transcript_agent}}",
       "since_seq": 0,
       "limit": 2
      }
     },
     "result": {
      "events": [
       {
        "seq": {
         "$save": "s1",
         "$type": "integer"
        }
       },
       {
        "seq": {
         "$next": "s1"
        }
       }
      ],
      "more": true
     }
    }
   ]
  },
  {
   "name": "transcript.events.since_the_newest_is_empty",
   "spec": "transcript.events",
   "about": "Reading after the newest seq gives no events, no gap and the same last_seq: a client that is up to date.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "transcript.events",
      "params": {
       "agent": "{{transcript_agent}}"
      }
     },
     "result": {
      "last_seq": {
       "$save": "last",
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "transcript.events",
      "params": {
       "agent": "{{transcript_agent}}",
       "since_seq": "{{last}}"
      }
     },
     "result": {
      "events": [],
      "more": false,
      "gap": false
     }
    }
   ]
  },
  {
   "name": "transcript.events.before_reads_the_older_page",

  {
   "name": "transcript.topic_is_a_topic",
   "spec": "transcript.events",
   "about": "The transcript topic is a known topic (the snapshot is transcript.events); the reply carries the cursor.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "transcript"
       ]
      }
     },
     "result": {
      "$exact": true,
      "cursor": {
       "$type": "integer"
      }
     }
    }
   ]
  },

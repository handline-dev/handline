  {
   "name": "devices.topic_events",
   "spec": "subscribe",
   "about": "A founder subscribed to the devices topic is sent device.paired (the Device) when a code is redeemed and device.revoked ({device}) when the device is revoked.",
   "as": "unpaired",
   "with": {
    "admin": "founder"
   },
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {
      "role": "founder"
     },
     "on": "admin"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "devices"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     },
     "on": "admin"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "device.pair",
      "params": {
       "request_id": "conf-dev-p3"
      }
     },
     "result": {
      "code": {
       "$type": "string",
       "$save": "code"
      },
      "expires_at": {
       "$type": "timestamp"
      },
      "fingerprint": {
       "$type": "string"
      },
      "uri": {
       "$type": "string"
      }
     },
     "on": "admin"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "device.redeem",
      "params": {
       "code": "{{code}}",
       "name": "conformance tablet",
       "request_id": "conf-dev-r4"
      }
     },
     "result": {
      "token": {
       "$type": "string",
       "$save": "token"
      },
      "device": {
       "$type": "string",
       "$save": "device"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "whoami",
      "params": {}
     },
     "result": {
      "role": "founder"
     },
     "on": "admin",
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "devices",
        "type": "device.paired",
        "agent": null,
        "data": {
         "id": {
          "$type": "string"
         },
         "name": "conformance tablet",
         "role": "founder",
         "connected": false,
         "last_seen": null
        }
       }
      }
     ]
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "device.revoke",
      "params": {
       "device": "{{device}}",
       "request_id": "conf-dev-v6-{{device}}"
      }
     },
     "result": {
      "accepted": true
     },
     "on": "admin",
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "devices",
        "type": "device.revoked",
        "agent": null,
        "data": {
         "device": {
          "$type": "string"
         }
        }
       }
      }
     ]
    }
   ]
  },

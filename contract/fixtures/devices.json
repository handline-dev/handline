{
 "fixtures": [
  {
   "name": "devices.unpaired_gets_nothing",
   "spec": "x-framing",
   "about": "On the network transport a connection with no valid device token is refused every call but device.redeem, hello and an unknown method included: gate unpaired, and the error holds only code, gate and reason (no data, no method list, no hint). One step per method of protocol.json.",
   "as": "unpaired",
   "for_each": "method",
   "except": [
    "device.redeem"
   ],
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "token": "not-a-token"
      }
     },
     "error": {
      "code": -32002,
      "message": "refused",
      "data": {
       "code": "refused",
       "gate": "unpaired",
       "reason": "not paired",
       "$exact": true
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "@method",
      "params": {}
     },
     "error": {
      "code": -32002,
      "message": "refused",
      "data": {
       "code": "refused",
       "gate": "unpaired",
       "reason": "not paired",
       "$exact": true
      }
     },
     "each": true
    }
   ]
  },
  {
   "name": "devices.pair_and_redeem_once",
   "spec": "device.redeem",
   "about": "A code from device.pair redeems once for a token; a second redeem of the same code is refused (pairing_code); the token's hello is the founder (a paired device is the founder); devices.list shows it.",
   "as": "unpaired",
   "with": {
    "admin": "founder"
   },
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {
      "role": "founder"
     },
     "on": "admin"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "device.pair",
      "params": {
       "name": "conformance phone",
       "request_id": "conf-dev-p2"
      }
     },
     "result": {
      "code": {
       "$type": "string",
       "$save": "code"
      },
      "expires_at": {
       "$type": "timestamp"
      },
      "fingerprint": {
       "$type": "string"
      },
      "uri": {
       "$type": "string"
      }
     },
     "on": "admin"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "device.redeem",
      "params": {
       "code": "{{code}}",
       "name": "conformance phone",
       "request_id": "conf-dev-r3"
      }
     },
     "result": {
      "token": {
       "$type": "string",
       "$save": "token"
      },
      "device": {
       "$type": "string",
       "$save": "device"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "device.redeem",
      "params": {
       "code": "{{code}}",
       "name": "conformance phone",
       "request_id": "conf-dev-r4"
      }
     },
     "error": {
      "code": -32002,
      "message": {
       "$regex": "."
      },
      "data": {
       "code": "refused",
       "gate": "pairing_code",
       "reason": {
        "$regex": "."
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 10,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "token": "{{token}}"
      }
     },
     "result": {
      "role": "founder",
      "caller": {
       "kind": "device",
       "device": "{{device}}"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 11,
      "method": "whoami",
      "params": {}
     },
     "result": {
      "role": "founder"
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "devices.list",
      "params": {}
     },
     "result": {
      "devices": {
       "$contains": {
        "name": "conformance phone",
        "role": "founder"
       }
      }
     },
     "on": "admin"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "device.revoke",
      "params": {
       "device": "{{device}}",
       "request_id": "conf-dev-v6-{{device}}"
      }
     },
     "result": {
      "accepted": true
     },
     "on": "admin"
    }
   ]
  },

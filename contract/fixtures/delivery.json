  {
   "name": "chat.cancel.withdraws_a_queued_operation_without_confirm",
   "spec": "chat.cancel",
   "about": "A queued message was never written, so chat.cancel takes it back with no confirm; a chat.send of its request_id after that is refused (gate state), so a retry does not bring it back.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{working_agent}}",
       "body": "take me back",
       "request_id": "d-cancel-1"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$type": "integer",
       "$save": "req"
      },
      "receipt": {
       "state": "queued"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "chat.cancel",
      "params": {
       "request": "{{req}}",
       "request_id": "d-cancel-now"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.send",
      "params": {
       "agent": "{{working_agent}}",
       "body": "take me back",
       "request_id": "d-cancel-1"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "state"
      }
     }
    }
   ]
  },

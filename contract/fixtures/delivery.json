{
 "fixtures": [
  {
   "name": "chat.send.an_idle_structured_agent_is_sent",
   "spec": "chat.send",
   "about": "A message to a structured agent with no turn running is written at once: receipt sent (or confirmed if the echo is already in), and chat.messages shows it with the same receipt.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{transcript_agent}}",
       "body": "idle hello",
       "request_id": "d-idle-1"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$type": "integer",
       "$save": "req"
      },
      "receipt": {
       "state": {
        "$oneOf": [
         "sent",
         "confirmed"
        ]
       },
       "uuid": {
        "$regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "chat.messages",
      "params": {
       "agent": "{{transcript_agent}}",
       "scope": "mine"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "body": "idle hello",
        "receipt": {
         "state": {
          "$oneOf": [
           "sent",
           "confirmed"
          ]
         },
         "uuid": {
          "$regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
         }
        }
       }
      }
     }
    }
   ]
  },
  {
   "name": "chat.send.a_repeat_returns_the_receipt_as_it_is_now",
   "spec": "chat.send",
   "about": "The same request_id and params writes nothing and returns replayed true with the receipt now: sent at first, confirmed once the CLI has echoed (the daemon under test echoes before the retry).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{transcript_agent}}",
       "body": "repeat hello",
       "request_id": "d-rep-1"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$type": "integer"
      },
      "receipt": {
       "state": {
        "$oneOf": [
         "sent",
         "confirmed"
        ]
       },
       "uuid": {
        "$regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
       }
      }
     }
    },
    {
     "sleep_s": 0.3,
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "chat.send",
      "params": {
       "agent": "{{transcript_agent}}",
       "body": "repeat hello",
       "request_id": "d-rep-1"
      }
     },
     "result": {
      "accepted": true,
      "replayed": true,
      "request": {
       "$type": "integer"
      },
      "receipt": {
       "state": "confirmed",
       "uuid": {
        "$regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.messages",
      "params": {
       "agent": "{{transcript_agent}}",
       "scope": "mine"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "body": "repeat hello",
        "receipt": {
         "state": "confirmed",
         "uuid": {
          "$regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
         }
        }
       }
      }
     }
    }
   ]
  },
  {
   "name": "chat.send.the_same_id_with_other_params_is_bad_request",
   "spec": "chat.send",
   "about": "A request_id already used for another body is bad_request naming request_id, and nothing is written.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{transcript_agent}}",
       "body": "first body",
       "request_id": "d-other-1"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "chat.send",
      "params": {
       "agent": "{{transcript_agent}}",
       "body": "second body",
       "request_id": "d-other-1"
      }
     },
     "error": {
      "code": -32600,
      "data": {
       "code": "bad_request",
       "field": "request_id"
      }
     }
    }
   ]
  },

  {
   "name": "account.add.registers_without_a_login",
   "spec": "account.add",
   "about": "NOT_YET_IN_PYTHON A good call registers the account and logs nothing in: it answers the name, the accounts topic sends account.changed with login_state needs_login, and accounts.list shows it. Needs --var add_account (a name no account has).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "accounts"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "account.add",
      "params": {
       "account": "{{add_account}}",
       "request_id": "conf-aa-7"
      }
     },
     "result": {
      "accepted": true,
      "account": "{{add_account}}"
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "accounts",
        "type": "account.changed",
        "data": {
         "name": {
          "$type": "string"
         },
         "login_state": "needs_login"
        }
       }
      }
     ],
     "notices_within_s": 5
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "accounts.list",
      "params": {}
     },
     "result": {
      "accounts": {
       "$contains": {
        "name": "{{add_account}}",
        "login_state": "needs_login"
       }
      }
     }
    }
   ]
  },

  {
   "name": "account.add.an_agent_session_is_refused_by_role",
   "spec": "account.add",
   "about": "NOT_YET_IN_PYTHON A call from an agent session is refused, gate role.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "account.add",
      "params": {
       "account": "conf.role",
       "request_id": "conf-aa-1"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "role"
      }
     }
    }
   ]
  },

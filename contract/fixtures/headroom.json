  {
   "name": "stats.headroom.a_span_has_a_point_every_step",
   "spec": "stats.headroom",
   "about": "A span and a step give the points from `from` on, every step, none after `to`.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "stats.headroom",
      "params": {
       "from": "2020-01-01T00:00:00Z",
       "to": "2020-01-01T00:30:00Z",
       "step_s": 600
      }
     },
     "result": {
      "step_s": 600,
      "combined": {
       "past": [
        {
         "at": "2020-01-01T00:00:00Z"
        },
        {
         "at": "2020-01-01T00:10:00Z"
        },
        {
         "at": "2020-01-01T00:20:00Z"
        },
        {
         "at": "2020-01-01T00:30:00Z"
        }
       ],
       "future": []
      }
     }
    }
   ]
  },

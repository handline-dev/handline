{
 "fixtures": [
  {
   "name": "later.set_replaces_and_clear_returns_a_task",
   "spec": "later.set",
   "about": "A deferred task carries later {until} on its read; a second set replaces the first; clear removes it; a second clear finds nothing.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "task.new",
      "params": {
       "owner": "human",
       "title": "later a",
       "body": "b",
       "request_id": "conf-later-f0-2-task.new"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "a0"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "later.set",
      "params": {
       "item": {
        "kind": "task",
        "id": "{{a0}}"
       },
       "until": "2099-01-01T00:00:00Z",
       "request_id": "conf-later-f0-3-later.set"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "task.get",
      "params": {
       "task": "{{a0}}"
      }
     },
     "result": {
      "later": {
       "$exact": true,
       "until": "2099-01-01T00:00:00Z"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "later.set",
      "params": {
       "item": {
        "kind": "task",
        "id": "{{a0}}"
       },
       "until": "2099-02-02T00:00:00Z",
       "request_id": "conf-later-f0-5-later.set"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "task.get",
      "params": {
       "task": "{{a0}}"
      }
     },
     "result": {
      "later": {
       "$exact": true,
       "until": "2099-02-02T00:00:00Z"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "later.clear",
      "params": {
       "item": {
        "kind": "task",
        "id": "{{a0}}"
       },
       "request_id": "conf-later-f0-7-later.clear"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "task.get",
      "params": {
       "task": "{{a0}}"
      }
     },
     "result": {
      "later": {
       "$absent": true
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 9,

{
 "fixtures": [
  {
   "name": "account.login.runs_to_done",
   "spec": "account.login",
   "about": "NOT_YET_IN_PYTHON A login answers its id and URL; the code brings it to code_sent and then done, the accounts topic says each step, and accounts.list then shows login_state ok. Needs --var login_account (an account with no login running), login_code (the code the daemon takes as right) and login_wrong_code (one it refuses).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "accounts"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "account.login",
      "params": {
       "account": "{{login_account}}",
       "request_id": "conf-lg-1"
      }
     },
     "result": {
      "accepted": true,
      "login_id": {
       "$save": "login_id"
      },
      "state": "waiting",
      "url": {
       "$type": "string"
      }
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "accounts",
        "type": "account.changed",
        "data": {
         "name": {
          "$type": "string"
         },
         "login": {
          "login_id": {
           "$type": "string"
          },
          "state": "waiting"
         }
        }
       }
      }
     ],
     "notices_within_s": 5
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "account.login_code",
      "params": {
       "login_id": "{{login_id}}",
       "code": "{{login_code}}",
       "request_id": "conf-lg-2"
      }
     },
     "result": {
      "accepted": true
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "accounts",
        "type": "account.changed",
        "data": {
         "name": {
          "$type": "string"
         },
         "login": {
          "login_id": {
           "$type": "string"
          },
          "state": "code_sent"
         }
        }
       }
      },
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "accounts",
        "type": "account.changed",
        "data": {
         "name": {
          "$type": "string"
         },
         "login": {
          "login_id": {
           "$type": "string"
          },
          "state": "done"
         },
         "login_state": "ok"
        }
       }
      }
     ],
     "notices_within_s": 5
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "accounts.list",
      "params": {}
     },
     "result": {
      "accounts": {
       "$contains": {
        "name": "{{login_account}}",
        "login_state": "ok",
        "login": {
         "login_id": "{{login_id}}",
         "state": "done"
        }
       }
      }
     }
    }
   ]
  },

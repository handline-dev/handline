{
 "fixtures": [
  {
   "name": "command_runs.running",
   "spec": "shell.open",
   "about": "A command that has not ended is a run in state running, without exit or seconds.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.send",
      "params": {
       "agent": "{{runs_agent}}",
       "body": "```sh\nsleep 30\n```",
       "request_id": "run-running"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$type": "integer",
       "$save": "req"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "shell.open",
      "params": {
       "agent": "{{runs_agent}}",
       "command": "sleep 30",
       "block": "{{req}}:0",
       "request_id": "open-running"
      }
     },
     "result": {
      "terminal": {
       "$type": "string",
       "$save": "win"
      }
     }
    },
    {
     "sleep_s": 0.5,
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.messages",
      "params": {
       "agent": "{{runs_agent}}",
       "scope": "mine"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "body": "```sh\nsleep 30\n```",
        "runs": [
         {
          "block": {
           "$regex": "^[0-9]+:0$"
          },
          "terminal": {
           "$type": "string"
          },
          "started_at": {
           "$type": "timestamp"
          },
          "state": "running"
         }
        ]
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 9,
      "method": "shell.close",
      "params": {
       "terminal": "{{win}}",
       "request_id": "end-running"
      }
     },
     "result": {
      "accepted": true
     }
    }
   ]
  },

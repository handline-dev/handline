   "spec": "chat.send",
   "about": "A reply item is accepted, and chat.messages then shows the message with parent_item {id, text}.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "chat.transcript",
      "params": {
       "agent": "{{reply_agent}}"
      }
     },
     "result": {
      "items": {
       "$contains": {
        "kind": "reply",
        "id": {
         "$type": "integer",
         "$save": "rid"
        }
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "chat.send",
      "params": {
       "agent": "{{reply_agent}}",
       "body": "answering",
       "parent_item": "{{rid}}",
       "request_id": "conf-pi-7"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$type": "integer",
       "$save": "mid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.messages",
      "params": {

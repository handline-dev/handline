   "spec": "agent.get",
   "about": "An agent that waits on a decision only a person can make has needs_you with a kind, since, a text and a source, and is waiting with attention alert. Needs --var view_alert_agent.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {

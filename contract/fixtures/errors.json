   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.get",
      "params": {}
     },
     "error": {
      "code": -32602,
      "message": "bad_request",
      "data": {
       "code": "bad_request",
       "field": "agent"
      }
     }
    }
   ]
  },
  {
   "name": "errors.not_found",
   "spec": "agent.get",
   "about": "An agent that does not exist is not_found.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.get",
      "params": {
       "agent": "no-such-agent.conformance"
      }
     },
     "error": {
      "code": -32001,
      "message": "not_found"
     }
    }
   ]

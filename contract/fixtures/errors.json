   "as": "founder",
   "steps": [
    {
     "raw": "this is not json",
     "error": {
      "code": -32700,
      "data": {
       "code": "bad_request"
      }
     }
    }
   ]
  },
  {
   "name": "errors.batch_is_bad_request",

   "steps": [
    {
     "raw": "[{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"hello\", \"params\": {\"client\": \"conformance/1\", \"protocol\": 1}}]",
     "error": {
      "code": -32600,
      "message": "bad_request",
      "data": {
       "code": "bad_request"
      }
     }
    }
   ]
  },
  {
   "name": "errors.invalid_params",
   "spec": "agent.get",

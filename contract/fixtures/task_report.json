  {
   "name": "task.accept.closes_a_report",
   "spec": "task.accept",
   "as": "agent",
   "with": {
    "boss": "founder"
   },
   "about": "A done by an owner the task does not answer to leaves it reported, the done its report; the opener's accept closes it with that evidence.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {
      "caller": {
       "name": {
        "$save": "me"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {},
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "task.new",
      "params": {
       "owner": "{{me}}",
       "title": "a reported task",
       "body": "build it; done is it built and tested",
       "time_box": "1h",
       "request_id": "conf-accept-1"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "tid"
      }
     },
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "task.done",
      "params": {
       "task": "{{tid}}",
       "evidence": "built and tested",
       "request_id": "conf-accept-2"
      }
     },
     "result": {
      "accepted": true,
      "said": {
       "$regex": "reported done"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "task.get",
      "params": {
       "task": "{{tid}}"
      }
     },
     "result": {
      "state": "reported",
      "evidence": {
       "$type": "null"
      },
      "report": {
       "by": "{{me}}",
       "evidence": "built and tested",
       "at": {
        "$type": "timestamp"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "task.done",
      "params": {
       "task": "{{tid}}",
       "evidence": "again",
       "request_id": "conf-accept-3"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "task.accept",
      "params": {
       "task": "{{tid}}",
       "request_id": "conf-accept-4"
      }
     },
     "result": {
      "accepted": true
     },
     "on": "boss"
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "task.get",
      "params": {
       "task": "{{tid}}"
      }
     },
     "result": {
      "state": "done",
      "evidence": "built and tested",
      "report": {
       "$type": "null"
      }
     }
    }
   ]
  },

{
 "fixtures": [
  {
   "name": "task.accept.unknown_task_is_not_found",
   "spec": "task.accept",
   "about": "No such task: not_found.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "task.accept",
      "params": {
       "task": 999999,
       "request_id": "conf-accept-0"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found"
      }
     }
    }
   ]
  },
  {

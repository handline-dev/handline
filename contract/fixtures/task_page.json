{
 "fixtures": [
  {
   "name": "task.get.carries_what_the_task_page_draws",
   "spec": "task.get",
   "about": "A task opened by an agent for itself: its detail says who it answers to, its clock, its sub-tasks and parent by title, its timeline as text already stripped of control characters, whom to ask, and the fields of a discard and a merge as null; tasks.list says when it last moved. Runs as an agent: no --var.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "whoami",
      "params": {}
     },
     "result": {
      "caller": {
       "name": {
        "$save": "me"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "task.new",
      "params": {
       "owner": "{{me}}",
       "title": "the page task",
       "body": "a brief the page shows",
       "time_box": "1h",
       "request_id": "conf-page-1"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "tid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "task.get",
      "params": {
       "task": "{{tid}}"
      }
     },
     "result": {
      "asker": {
       "$type": "string"
      },
      "discarded": {
       "$type": "null"
      },
      "merged_into": {
       "$type": "null"
      },
      "time": {
       "length_s": 3600,
       "default": {
        "$type": "boolean"
       },

         {
          "$type": "timestamp"
         },
         {
          "$type": "null"
         }
        ]
       },
       "overdue_since": {
        "$oneOf": [
         {
          "$type": "timestamp"
         },
         {
          "$type": "null"
         }
        ]
       },
       "told": {
        "$type": "integer"
       }
      },
      "parent_title": {
       "$type": "null"
      },
      "subtasks": [],
      "timeline": {
       "$type": "array"
      },
      "people": {
       "recent": {
        "$type": "array"
       },
       "team": {
        "$type": "array"
       },
       "others": {
        "$type": "array"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tasks.list",
      "params": {}
     },
     "result": {
      "items": {
       "$contains": {
        "id": "{{tid}}",
        "last_activity": {
         "$type": "timestamp"
        }
       }
      }
     }
    }
   ]
  },
  {

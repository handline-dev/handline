  {
   "name": "prefs.set.a_renamed_agent_keeps_its_place_in_the_order",
   "spec": "prefs.set",
   "as": "founder",
   "with": {
    "lead": "agent"
   },
   "about": "An approved hr rename puts the new name in the old one's place in order and sends prefs.changed. Needs --var order_a, order_rename_agent (an agent hr may rename) and order_rename_to (a free name).",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "on": "lead",
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "prefs"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "prefs.set",
      "params": {
       "changes": {
        "nav": {
         "order": [
          "{{order_a}}",
          "{{order_rename_agent}}"
         ]
        }
       },
       "request_id": "conf-prefs-order-10"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "on": "lead",
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "hr.propose",
      "params": {
       "kind": "rename",
       "args": {
        "name": "{{order_rename_agent}}",
        "to": "{{order_rename_to}}"
       },
       "why": "conformance: the order follows a rename",
       "request_id": "conf-prefs-order-11"
      }
     },
     "result": {
      "accepted": true,
      "proposal": {
       "$save": "rename_id"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "hr.list",
      "params": {
       "state": "open"
      }
     },
     "result": {
      "proposals": {
       "$contains": {
        "id": "{{rename_id}}",
        "subject": {
         "$save": "rename_subject"
        }
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "hr.decide",
      "params": {
       "proposal": "{{rename_id}}",
       "decision": "approve",
       "subject": "{{rename_subject}}",
       "request_id": "conf-prefs-order-12"
      }
     },
     "result": {
      "accepted": true
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "prefs",
        "type": "prefs.changed",
        "data": {
         "nav": {
          "order": [
           "{{order_a}}",
           "{{order_rename_to}}"
          ]
         }
        }
       }
      }
     ],
     "notices_within_s": 10
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "prefs.get",
      "params": {}
     },
     "result": {
      "nav": {
       "order": [
        "{{order_a}}",
        "{{order_rename_to}}"
       ]
      }
     }
    }
   ]
  },
  {
   "name": "prefs.get.an_agent_session_is_refused",
   "spec": "prefs.get",
   "as": "agent",
   "about": "Prefs are a person's: an agent session is refused.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",

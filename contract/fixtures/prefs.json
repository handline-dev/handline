     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "prefs.set",
      "params": {
       "changes": {},
       "request_id": "conf-prefs-7"
      }
     },
     "error": {
      "code": -32602,
      "data": {
       "code": "bad_request",
       "field": "changes.nav"
      }
     }
    }
   ]
  },
  {
   "name": "prefs.get.an_agent_session_is_refused",
   "spec": "prefs.get",
   "as": "agent",
   "about": "Prefs are a person's: an agent session is refused.",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "prefs.get",
      "params": {}
     },
     "error": {
      "code": -32002,
      "message": {
       "$regex": "."
      },
      "data": {
       "code": "refused",
       "gate": "role",
       "reason": {
        "$type": "string"
       }
      }
     }
    }
   ]
  }
 ]
}

      "id": 4,
      "method": "prefs.set",
      "params": {
       "changes": {
        "nav": {
         "layout": "grid"
        }
       },
       "request_id": "conf-prefs-5"
      }
     },
     "error": {
      "code": -32602,
      "data": {
       "code": "bad_request",
       "field": "changes.nav.layout"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "prefs.set",
      "params": {
       "changes": {
        "nav": {
         "colour": "red"
        }
       },
       "request_id": "conf-prefs-6"

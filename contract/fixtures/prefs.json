      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "prefs.get",
      "params": {}
     },
     "error": {
      "code": -32002,
      "message": {
       "$regex": "."
      },
      "data": {
       "code": "refused",
       "gate": "role",
       "reason": {
        "$type": "string"
       }
      }
     }
    }
   ]
  }
 ]

       "$type": "array"
      }
     }
    }
   ]
  },
  {
   "name": "inbox.queue.an_agents_has_a_head_or_none",
   "spec": "inbox.queue",
   "about": "An agent's inbox, read by the founder: the head of its queue or null, and with all its history (needs --var ask_agent).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "inbox.queue",
      "params": {
       "whose": "{{ask_agent}}",
       "all": true
      }
     },
     "result": {
      "whose": "{{ask_agent}}",
      "newest": {
       "$type": "integer"
      },
      "head": {
       "$oneOf": [
        {
         "$type": "object"
        },
        null
       ]
      },
      "history": {
       "$type": "array"
      }
     }
    }
   ]
  },
  {
   "name": "inbox.queue.wait_is_bounded",
   "spec": "inbox.queue",
   "about": "wait_s over 600 is invalid params naming wait_s.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "inbox.queue",
      "params": {
       "wait_s": 601
      }
     },
     "error": {
      "code": -32602,
      "message": {
       "$regex": "."
      },
      "data": {
       "code": "bad_request",
       "field": "wait_s"
      }
     }
    }
   ]
  },

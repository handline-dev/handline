{
 "fixtures": [
  {
   "name": "inbox.queue.the_founders_is_the_mailbox",
   "spec": "inbox.queue",
   "about": "The founder's own inbox is the mailbox: no head, how many wait and a line per agent.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "inbox.queue",
      "params": {}
     },
     "result": {
      "whose": "human",
      "newest": {
       "$type": "integer"
      },
      "head": null,
      "waiting": {
       "$type": "integer"
      },
      "lines": {
       "$type": "array"
      }
     }
    }
   ]
  },
  {
   "name": "inbox.queue.all_adds_what_was_dealt_with",
   "spec": "inbox.queue",
   "about": "With all the founder's inbox also lists what was already dealt with.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}

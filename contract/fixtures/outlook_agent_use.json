     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "stats.outlook",
      "params": {
       "range": "7d"
      }
     },
     "result": {
      "agent_use": {
       "$type": "array",
       "$each": {
        "agent": {
         "$type": "string"
        },
        "tokens": {
         "$type": "integer"
        },
        "cost": {
         "$type": "number"
        },
        "share": {
         "$type": "number"
        },
        "est_pct": {
         "$oneOf": [
          {
           "$type": "number"
          },
          {
           "$type": "null"
          }
         ]
        },
        "fracs": {
         "$type": "object"
        }
       },
       "$contains": {
        "agent": "{{outlook_agent}}"
       }
      },
      "overlay": {
       "$absent": true
      }
     }
    }
   ]
  },

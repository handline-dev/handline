    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "task.new",
      "params": {
       "owner": "human",
       "title": "closed old id",
       "body": "b",
       "request_id": "conf-closed-2-task.new"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "a"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "task.new",
      "params": {
       "owner": "human",
       "title": "closed new id",
       "body": "b",
       "request_id": "conf-closed-3-task.new"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "b"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "task.done",
      "params": {
       "task": "{{b}}",
       "evidence": "closed in the fixture",
       "request_id": "conf-closed-4-task.done"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "task.done",
      "params": {
       "task": "{{a}}",
       "evidence": "closed in the fixture",
       "request_id": "conf-closed-5-task.done"
      }
     },
     "result": {
      "accepted": true
     },
     "sleep_s": 1.2
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tasks.list",
      "params": {

    {
     "send": {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tasks.list",
      "params": {
       "state": "done",
       "order": "closed",
       "limit": 1,
       "cursor": "{{cur}}"
      }
     },
     "result": {
      "items": [
       {
        "id": "{{b}}"
       }
      ]
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 8,

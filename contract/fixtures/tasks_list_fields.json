{
 "fixtures": [
  {
   "name": "tasks.list.blocked_by_names_the_open_blockers",
   "spec": "tasks.list",
   "about": "NOT_YET_IN_PYTHON: Every task row has blocked_by, a list of integers; a task an open blocker holds lists it, and its block_reason says so. Needs --var tasks_blocked_owner: an agent that owns a task held by an open blocker and the blocker, two tasks.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tasks.list",
      "params": {
       "owner": "{{tasks_blocked_owner}}"
      }
     },
     "result": {
      "items": {
       "$type": "array",
       "$each": {
        "blocked_by": {
         "$type": "array",
         "$each": {
          "$type": "integer"
         }
        }
       },
       "$contains": {
        "blocked_by": {
         "$contains": {
          "$type": "integer"
         }
        },
        "block_reason": {
         "$type": "string"
        }
       }
      }
     }
    }
   ]
  },

  {
   "name": "tasks.list.before_pages_through_every_task",
   "spec": "tasks.list",
   "about": "NOT_YET_IN_PYTHON: all, limit 200 and before page through every task, newest id first: a page of one says there is more, and before its id gives the one after. Needs --var tasks_blocked_owner: an agent that owns exactly two tasks.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tasks.list",
      "params": {
       "owner": "{{tasks_blocked_owner}}",
       "all": true,
       "limit": 1
      }
     },
     "result": {
      "items": [
       {
        "id": {
         "$save": "top"
        }
       }
      ],
      "more": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "tasks.list",
      "params": {
       "owner": "{{tasks_blocked_owner}}",
       "all": true,
       "limit": 1,
       "before": "{{top}}"
      }
     },
     "result": {
      "items": [
       {
        "id": {
         "$type": "integer"
        }
       }
      ],
      "more": false
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "tasks.list",
      "params": {
       "owner": "{{tasks_blocked_owner}}",
       "all": true,
       "limit": 200
      }
     },
     "result": {

            "$absent": true
           }
          },
          "caption": "the button",
          "gone": true,
          "removed": true
         }
        ]
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 11,
      "method": "task.get",
      "params": {
       "task": "{{tid}}"
      }
     },
     "result": {
      "memos": {
       "$contains": {
        "text": "still ![the button](attachment:{{aid}})",
        "parts": [
         {
          "text": "still "
         },
         {
          "image": {
           "id": "{{aid}}",
           "name": {
            "$absent": true
           }
          },
          "caption": "the button",
          "gone": true,
          "removed": true
         }
        ]
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 12,
      "method": "attachment.get",
      "params": {
       "id": "{{aid}}"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found",
       "what": "attachment"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 13,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "again ![the button](attachment:{{aid}})",
       "request_id": "conf-rm-7"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found",
       "what": "attachment"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 14,
      "method": "attachment.remove",
      "params": {
       "id": "{{aid}}",
       "request_id": "conf-rm-8"
      }
     },
     "result": {
      "accepted": true,
      "removed_from": 0
     }
    }

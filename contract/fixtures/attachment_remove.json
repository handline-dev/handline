       "text": "still ![the button](attachment:{{aid}})",
       "request_id": "conf-rm-4"
      }
     },
     "result": {
      "accepted": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "attachment.remove",
      "params": {
       "id": "{{aid}}",
       "dry_run": true,
       "request_id": "conf-rm-5"
      }
     },
     "result": {
      "accepted": true,
      "said": {
       "$type": "string"
      },
      "removed_from": 2
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "attachment.get",
      "params": {
       "id": "{{aid}}"
      }
     },
     "result": {
      "mime": "image/png",
      "bytes": 70,
      "done": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 9,
      "method": "attachment.remove",
      "params": {
       "id": "{{aid}}",
       "request_id": "conf-rm-6"
      }
     },
     "result": {
      "accepted": true,
      "said": {
       "$type": "string"
      },
      "removed_from": 2
     },
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "chat",
        "type": "attachment.removed",
        "data": {
         "id": "{{aid}}"
        }
       }
      },
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "tasks",
        "type": "attachment.removed",
        "data": {
         "id": "{{aid}}"
        }
       }
      }
     ],
     "notices_any_order": true
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 10,

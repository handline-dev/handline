 "fixtures": [
  {
   "name": "attachment.remove.deletes_it_everywhere_it_is_named",
   "spec": "attachment.remove",
   "about": "An image a message and a task comment name: a dry run counts 2 and keeps it; the remove deletes it, both reads say gone and removed, attachment.get and a new text naming it are not_found, attachment.removed goes on chat and tasks, and a second remove is accepted with 0.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "chat",
        "tasks"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "attachment.put",
      "params": {
       "name": "a.png",
       "mime": "image/png",
       "bytes": 70,
       "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
       "request_id": "conf-rm-1"
      }
     },
     "result": {
      "attachment": {
       "id": {
        "$regex": "^[0-9a-f]{16}$",
        "$save": "aid"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.send",
      "params": {
       "agent": "{{ask_agent}}",
       "body": "see ![the button](attachment:{{aid}})",
       "request_id": "conf-rm-2"
      }
     },
     "result": {
      "accepted": true,
      "request": {
       "$save": "rid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "task.new",
      "params": {
       "owner": "human",
       "title": "a todo whose comment has a picture",
       "body": "no picture here",
       "request_id": "conf-rm-3"
      }
     },
     "result": {
      "accepted": true,
      "task": {
       "$save": "tid"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 6,

  {
   "name": "agent.retire.an_agent_with_agents_under_it_is_refused",
   "spec": "agent.retire",
   "about": "An agent another agent hangs under, or reports to, is refused (gate state) and the reason says so and names them; nothing is retired.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.retire",
      "params": {
       "agent": "{{retire_parent}}",
       "request_id": "conf-ret-3"
      }
     },
     "error": {
      "code": -32002,
      "data": {
       "code": "refused",
       "gate": "state",
       "reason": {
        "$regex": "has agents under it"
       }
      }
     }
    }
   ]
  },
  {
   "name": "agent.retire.a_running_agent_is_retired_when_its_turn_ends",
   "spec": "agent.retire",
   "about": "An agent mid-turn is accepted, not refused, with a said naming it; it stays until its turn ends and is then removed. Needs --var retire_turn_agent (an agent the founder may retire, mid-turn in a turn that ends on its own 20 to 60 s after the fixture starts).",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "agents"
       ]
      }
     },
     "result": {
      "cursor": {
       "$type": "integer"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "agent.retire",
      "params": {
       "agent": "{{retire_turn_agent}}",
       "request_id": "conf-ret-4"
      }
     },
     "result": {
      "accepted": true,
      "said": {
       "$regex": "{{retire_turn_agent}}"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "agent.get",
      "params": {
       "agent": "{{retire_turn_agent}}"
      }
     },
     "result": {
      "name": "{{retire_turn_agent}}",
      "session_open": true
     }
    },
    {
     "notices": [
      {
       "jsonrpc": "2.0",
       "method": "event",
       "params": {
        "topic": "agents",
        "type": "agent.removed",
        "data": {
         "name": "{{retire_turn_agent}}"
        }
       }
      }
     ],
     "notices_within_s": 90
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "agent.get",
      "params": {
       "agent": "{{retire_turn_agent}}"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found"
      }
     }
    }
   ]
  },
  {
   "name": "agent.retire.retires_and_the_agent_is_gone",
   "spec": "agent.retire",
   "about": "A retired agent is accepted with a said line, a retry of the same request_id is replayed and retires nothing twice, and the agent is then not_found.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.retire",
      "params": {
       "agent": "{{retire_agent}}",
       "request_id": "conf-ret-5"
      }
     },
     "result": {
      "accepted": true,
      "said": {
       "$regex": "is retired"
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "agent.retire",
      "params": {
       "agent": "{{retire_agent}}",
       "request_id": "conf-ret-5"
      }
     },
     "result": {
      "accepted": true,
      "replayed": true
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "agent.retire",
      "params": {
       "agent": "{{retire_agent}}",
       "request_id": "conf-ret-6"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found"
      }
     }
    }
   ]
  }
 ]
}

{
 "fixtures": [
  {
   "name": "agent.retire.unknown_agent_is_not_found",
   "spec": "agent.retire",
   "about": "An agent the daemon does not have is not_found; nothing is retired.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.retire",
      "params": {
       "agent": "nobody.here",
       "request_id": "conf-ret-1"
      }
     },
     "error": {
      "code": -32001,
      "data": {
       "code": "not_found"
      }
     }
    }
   ]
  },
  {
   "name": "agent.retire.needs_a_request_id",
   "spec": "agent.retire",
   "about": "A write without a request_id is bad_request naming it.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "agent.retire",
      "params": {
       "agent": "nobody.here"
      }
     },
     "error": {
      "code": -32600,
      "data": {
       "code": "bad_request",
       "field": "request_id"
      }
     }
    }
   ]
  },
  {
   "name": "agent.retire.an_agent_session_is_refused_by_role",

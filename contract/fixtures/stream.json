{
 "fixtures": [
  {
   "name": "subscribe.returns_the_cursor",
   "spec": "subscribe",
   "about": "The reply carries the newest cursor, an integer.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "subscribe",
      "params": {
       "topics": [
        "agents"
       ]
      }
     },
     "result": {
      "$exact": true,
      "cursor": {
       "$type": "integer"
      }
     }
    }
   ]
  },
  {
   "name": "subscribe.refuses_an_unknown_topic",
   "spec": "subscribe",
   "about": "A topic that does not exist is invalid params naming topics.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,

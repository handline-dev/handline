  {
   "name": "events.feed.shape",
   "spec": "events.feed",
   "about": "events, cursor and gap; each event carries an integer cursor.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1,
       "key": "{{founder_key}}"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "events.feed",
      "params": {
       "limit": 5
      }
     },
     "result": {
      "$exact": true,
      "events": {
       "$each": {
        "cursor": {
         "$type": "integer"
        },
        "topic": "notifications",
        "at": {
         "$type": "timestamp"
        }
       }
      },
      "cursor": {
       "$type": "integer"
      },
      "gap": {
       "$type": "boolean"
      }
     }
    }

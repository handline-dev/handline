{
 "fixtures": [
  {
   "name": "whoami.founder",
   "spec": "whoami",
   "about": "The local founder: role, caller and the methods it may call, with allowed flags in hello.",
   "as": "founder",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {
      "role": "founder",
      "methods": {
       "$contains": {
        "name": "settings.set",
        "allowed": true
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "whoami",
      "params": {}
     },
     "result": {
      "caller": {
       "kind": "person"
      },
      "role": "founder",
      "methods": {
       "$contains": "settings.set"
      }
     }
    }
   ]
  },
  {

       "protocol": 1
      }
     },
     "result": {
      "role": "agent",
      "caller": {
       "kind": "agent",
       "name": {
        "$type": "string"
       }
      },
      "methods": {
       "$contains": {
        "name": "task.new",
        "allowed": true
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {
      "methods": {
       "$contains": {
        "name": "settings.set",

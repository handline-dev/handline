  {
   "name": "chat.search.an_agent_finds_what_it_sent",
   "spec": "chat.search",
   "about": "An agent's search with no agent is its own messages: what it sent is found, every hit is from or to it and shown in its chat. Needs --var task_owner=NAME: an agent other than the caller.",
   "as": "agent",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "client": "conformance/1",
       "protocol": 1
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "whoami",
      "params": {}
     },
     "result": {
      "caller": {
       "name": {
        "$save": "me"
       }
      }
     }
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "say",
      "params": {
       "target": "{{task_owner}}",
       "body": "chat-search-probe sent",
       "request_id": "conf-cs-1"
      }
     },
     "result": {}
    },
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "chat.search",
      "params": {
       "query": "chat-search-probe"
      }
     },
     "result": {
      "messages": {
       "$contains": {
        "from": "{{me}}",
        "to": "{{task_owner}}",
        "body": "chat-search-probe sent",
        "agent": "{{me}}"
       },
       "$each": {
        "$oneOf": [
         {
          "from": "{{me}}"
         },
         {
          "to": "{{me}}"
         }
        ]
       }
      }
     }
    }
   ]
  },
